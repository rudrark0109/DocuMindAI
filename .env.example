# Used when running the backend directly on the host. Docker Compose overrides
# the database hostname and internal port automatically.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/documind_ai
FRONTEND_ORIGIN=http://localhost:5173

# PaddleOCR defaults are tuned for English documents on CPU.
PADDLE_OCR_LANGUAGE=en
PADDLE_OCR_VERSION=PP-OCRv6
PADDLE_OCR_DEVICE=cpu
OCR_RENDER_DPI=200
OCR_TEXT_SCORE_THRESHOLD=0.5
OCR_USE_DOC_ORIENTATION=true
OCR_USE_TEXTLINE_ORIENTATION=true
