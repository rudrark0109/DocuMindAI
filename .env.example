# Used when running the backend directly on the host. Docker Compose overrides
# the database hostname and internal port automatically.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/documind_ai
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_SIZE_MB=25

# PaddleOCR defaults are tuned for English documents on CPU.
PADDLE_OCR_LANGUAGE=en
PADDLE_OCR_VERSION=PP-OCRv6
PADDLE_OCR_DEVICE=cpu
OCR_RENDER_DPI=150
OCR_LARGE_DOCUMENT_PAGE_THRESHOLD=20
OCR_LARGE_DOCUMENT_DPI=96
OCR_MAX_RENDER_SIDE=2400
OCR_MAX_RENDER_PIXELS=4000000
OCR_TEXT_SCORE_THRESHOLD=0.5
OCR_USE_DOC_ORIENTATION=false
OCR_USE_TEXTLINE_ORIENTATION=false
OCR_ENABLE_MKLDNN=false
RAG_PROVIDER=auto
# With auto and no key, the safe extractive fallback is used.
RAG_GEMINI_API_KEY=
RAG_GEMINI_MODEL=gemini-2.5-flash
RAG_SIMILARITY_THRESHOLD=0.25
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_CITATIONS=8
